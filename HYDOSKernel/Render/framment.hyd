#ifndef HYD_frament
#define HYD_frament
#include"../limine.h"
#include <stdint.h>
struct fb
{
    void*    address;
    uint64_t width  ;
    uint64_t height ;
    uint64_t pitch  ;
    uint16_t bpp    ;

    fb();
    bool Init();
};

void putpixel(fb& ,uint64_t x,uint64_t y,uint32_t color);
void clear(fb&,uint32_t color);
void Drawrect(fb&,uint64_t x,uint64_t y,uint64_t w,uint64_t h,uint32_t color);

#endif